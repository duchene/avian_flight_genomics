# 22_age_latency.Rscript
#
# Does sister-pair age change how much molecular divergence accumulates, and is that a
# trait effect or just more time?
#
# Three referees made the same objection: sister-pair divergence time is not the age of
# the trait transition. A pair that diverged 20 Ma may have carried the derived flight
# habit for 20 Ma or for 2 Ma. The previous version showed molecular contrast growing
# with pair age and read it as clock-like accumulation driven by the trait. The same plot
# supports the reading that older pairs have had more time to accumulate any difference.
#
# Three analyses separate those readings.
#   (a) interaction  Does the trait effect steepen with the time available? This, not a
#                    main effect of age, is the test.
#   (b) baseline     The age effect within minimal-change pairs is accumulation with no
#                    trait change. The trait effect is whatever exceeds it.
#   (c) latency      Which transition latencies reproduce the observed age relationship?
#                    Requested explicitly by NEE Reviewer 1.
#
# Requires: none beyond base R
# In:  ../output/rate_contrasts.csv
# Out: ../output/age_models.csv, ../output/latency_sim.csv,
#      ../figures/Fig5_age.pdf

set.seed(42)
N_REP <- 2000

dat <- read.csv("../output/rate_contrasts.csv", stringsAsFactors = FALSE)
dir.create("../output", showWarnings = FALSE)
dir.create("../figures", showWarnings = FALSE)

responses <- c("med_logratio_ds", "med_logratio_dn", "med_logratio_w")
dat$abs_ds <- abs(dat$med_logratio_ds)
dat$abs_dn <- abs(dat$med_logratio_dn)
dat$abs_w  <- abs(dat$med_logratio_w)

cat("pairs:", nrow(dat), " age range", paste(round(range(dat$age), 1), collapse = " to "),
    "Ma\n")
cat("minimal-change pairs:", sum(dat$habit == "minimal"), "\n\n")


# ---- (a) Interaction model ----
#
# A positive interaction means the trait effect grows with the time available, which is
# what clock-like accumulation of a trait-driven difference predicts.

fit_int <- function(y) {
  m <- lm(as.formula(paste(y, "~ age * d_loading + migration_pair + d_logmass")), data = dat)
  s <- summary(m)
  cf <- as.data.frame(s$coefficients)
  names(cf) <- c("estimate", "se", "t", "p")
  data.frame(response = y, term = rownames(cf), cf, r2 = s$r.squared, row.names = NULL)
}
int_tab <- do.call(rbind, lapply(responses, fit_int))
cat("(a) Interaction between pair age and the flight index:\n\n")
print(format(int_tab[grepl("age", int_tab$term),
                     c("response", "term", "estimate", "se", "p")], digits = 3),
      row.names = FALSE)


# ---- (b) Baseline accumulation in minimal-change pairs ----
#
# Fitted on the absolute contrast, since with no trait change there is no expected
# direction and only the magnitude of divergence should grow with time.

mini <- dat[dat$habit == "minimal", ]
rest <- dat[dat$habit != "minimal", ]
base_tab <- do.call(rbind, lapply(c("abs_ds", "abs_dn", "abs_w"), function(y) {
  mm <- lm(as.formula(paste(y, "~ age")), data = mini)
  mr <- lm(as.formula(paste(y, "~ age")), data = rest)
  data.frame(response = y,
             slope_minimal = coef(mm)[2], p_minimal = summary(mm)$coefficients[2, 4],
             slope_changed = coef(mr)[2], p_changed = summary(mr)$coefficients[2, 4],
             excess = coef(mr)[2] - coef(mm)[2], row.names = NULL)
}))
cat("\n(b) Accumulation with age, minimal-change pairs versus pairs with a trait change:\n\n")
print(format(base_tab, digits = 3), row.names = FALSE)
cat("\n   'excess' is the slope attributable to the trait rather than to elapsed time.\n")

write.csv(rbind(
  cbind(analysis = "interaction", int_tab[, c("response", "term", "estimate", "se", "p")]),
  cbind(analysis = "baseline", data.frame(response = base_tab$response, term = "age",
        estimate = base_tab$excess, se = NA, p = base_tab$p_changed))),
  "../output/age_models.csv", row.names = FALSE)


# ---- (c) Latency simulation ----
#
# If the trait shift began at fraction f of the way along the branch, only (1 - f) of the
# pair's age has been spent under the differing regime, so the expected contrast is
#
#     y = beta * (1 - f) * age * d_loading + noise
#
# This model only applies to pairs that underwent a trait change, so minimal-change pairs
# are excluded here; f is undefined where nothing changed. For a grid of f the simulation
# records the correlation between contrast and age that the trait model can produce. If
# the observed correlation lies outside that range at every f, the age relationship is
# not generated by the trait, whatever the latency.

ch <- dat[dat$habit != "minimal", ]
cat("\n(c) Latency simulation on the", nrow(ch), "pairs with a trait change\n")

obs_cor <- sapply(responses, function(y) cor(ch[[y]], ch$age))
cat("    observed correlation between contrast and pair age:\n")
print(round(obs_cor, 3))

f_grid <- seq(0, 0.9, by = 0.1)
age_c <- as.numeric(scale(ch$age))
x_c   <- as.numeric(scale(ch$d_loading))

lat <- do.call(rbind, lapply(responses, function(y) {
  sigma <- sd(ch[[y]]); beta <- sd(ch[[y]])
  do.call(rbind, lapply(f_grid, function(f) {
    sim <- replicate(N_REP, {
      yy <- beta * (1 - f) * age_c * x_c + rnorm(nrow(ch), 0, sigma)
      cor(yy, ch$age)
    })
    data.frame(response = y, f = f, sim_mean = mean(sim),
               lwr = unname(quantile(sim, .025)), upr = unname(quantile(sim, .975)),
               observed = obs_cor[[y]],
               compatible = obs_cor[[y]] >= quantile(sim, .025) &
                            obs_cor[[y]] <= quantile(sim, .975),
               row.names = NULL)
  }))
}))
write.csv(lat, "../output/latency_sim.csv", row.names = FALSE)

cat("\n    latencies compatible with the observation (95% simulation interval):\n")
for (y in responses) {
  s <- lat[lat$response == y, ]
  ok <- s$f[s$compatible]
  if (length(ok)) {
    cat(sprintf("      %-16s f = %s\n", y, paste(range(ok), collapse = " to ")))
  } else {
    side <- if (s$observed[1] > max(s$upr)) "above" else "below"
    cat(sprintf("      %-16s none. Observed r = %.2f lies %s everything the trait model\n",
                y, s$observed[1], side))
    cat(sprintf("      %-16s can produce (max simulated upper bound %.2f at f = %.1f).\n",
                "", max(s$upr), s$f[which.max(s$upr)]))
  }
}
cat("\n    f is the fraction of the branch elapsed before the transition began.\n")
cat("    f = 0 means the trait changed at divergence, f = 0.9 means very recently.\n")
cat("    Where no f is compatible, the trait model cannot reproduce the observed age\n")
cat("    relationship at any latency. Read this alongside analysis (b), which compares\n")
cat("    the age slopes of minimal-change and changed pairs directly.\n")


# ---- Figure ----

pdf("../figures/Fig5_age.pdf", width = 10, height = 6.6)
par(mfrow = c(2, 3), mar = c(4.2, 4.4, 2.6, 1), tcl = -0.25, mgp = c(2.5, 0.5, 0),
    cex.axis = 0.85)
nm <- c(med_logratio_ds = "dS", med_logratio_dn = "dN", med_logratio_w = "omega")
pal <- c(minimal = "#9AA5AB", changed = "#2B7A9B")

for (y in responses) {
  grp <- ifelse(dat$habit == "minimal", "minimal", "changed")
  plot(dat$age, dat[[y]], type = "n", xlab = "", ylab = "",
       main = nm[y], font.main = 1, cex.main = 1)
  abline(h = 0, col = "grey88")
  for (g in c("minimal", "changed")) {
    i <- grp == g
    abline(lm(dat[[y]][i] ~ dat$age[i]), col = pal[g], lwd = 2)
  }
  points(dat$age, dat[[y]], pch = 21, cex = 1.15, lwd = 0.7, col = "white", bg = pal[grp])
  mtext("sister-pair age (Ma)", side = 1, line = 2.4, cex = 0.72)
  mtext("median log(greater / lesser)", side = 2, line = 2.5, cex = 0.72)
  if (y == responses[1])
    legend("topleft", bty = "n", cex = 0.72, pch = 21, pt.lwd = 0.7, col = "white",
           pt.bg = pal, legend = c("minimal change", "trait change"))
  box(bty = "l", col = "grey45")
}

for (y in responses) {
  s <- lat[lat$response == y, ]
  plot(s$f, s$sim_mean, type = "n", ylim = range(c(s$lwr, s$upr, s$observed)),
       xlab = "", ylab = "", main = paste(nm[y], "latency"), font.main = 1, cex.main = 1)
  polygon(c(s$f, rev(s$f)), c(s$lwr, rev(s$upr)), col = "grey92", border = NA)
  lines(s$f, s$sim_mean, col = "grey35", lwd = 2)
  abline(h = s$observed[1], col = "#D1793B", lwd = 2.2, lty = 2)
  ok <- s$f[s$compatible]
  if (length(ok)) rug(ok, col = "#D1793B", lwd = 2.5, ticksize = 0.05)
  mtext("f, fraction of branch before transition", side = 1, line = 2.4, cex = 0.72)
  mtext("correlation of contrast with age", side = 2, line = 2.5, cex = 0.72)
  if (y == responses[1])
    legend("topright", bty = "n", cex = 0.72, lwd = c(2, 2.2), lty = c(1, 2),
           col = c("grey35", "#D1793B"), seg.len = 1.4,
           legend = c("simulated", "observed"))
  box(bty = "l", col = "grey45")
}
dev.off()
cat("\nwritten ../figures/Fig5_age.pdf\n")
