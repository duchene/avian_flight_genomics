# 23_mrpmm.Rscript
#
# Multi-response phylogenetic mixed model across the 84-taxon phylogeny.
#
# Replaces the frequentist and Bayesian path analyses of the previous version. Those
# fitted a directed chain chosen in advance and compared seven such chains. An MR-PMM
# instead estimates the full covariance among traits and splits it into a part following
# the phylogeny and a part that does not. Following Halliwell, Holland and Yates (2025).
#
# ---------------------------------------------------------------------------------
# WHY THE FIRST VERSION FAILED, AND WHAT CHANGED
#
# The first specification used ln dN and ln dS as separate responses and would not
# converge: Rhat 1.99, minimum ESS ratio 0.01, 40 divergent transitions, and a full hour
# without finishing on production settings. Two measured pathologies explain it.
#
#   1. ln dN and ln dS correlate at r = 0.970 across taxa. Both are dominated by terminal
#      branch length, so the model was asked to estimate a correlation against the
#      boundary of the correlation matrix, where sampling collapses.
#
#   2. Pagel's lambda was at or above 1 for ln dN (1.04), ln dS (1.02) and the flight
#      index (0.96). Lambda >= 1 means the non-phylogenetic variance wants to be zero, so
#      a residual correlation matrix was being estimated from variances pinned at the
#      floor. That is the classic funnel.
#
# The fix is to use dS and OMEGA rather than dN and dS. Omega is their ratio, so it
# carries exactly the variation left after the shared branch-length component is removed.
# Measured: collinearity falls from 0.970 to 0.505, and omega has lambda = 0.000, giving
# the residual term real variance to estimate instead of a boundary.
#
#   dS     carries the phylogenetically structured mutation-rate signal (lambda 0.80)
#   omega  carries the unstructured selection signal                    (lambda 0.00)
#
# ---------------------------------------------------------------------------------
# RESPONSES
#
# Seven per taxon, chosen on measured collinearity, skew and phylogenetic signal rather
# than convenience. Maximum pairwise |r| is 0.57.
#
#   ln_ds          genome-wide synonymous rate           lambda 0.80
#   ln_w           genome-wide omega                     lambda 0.00
#   loading_index  ln(mass / wing length^2)              lambda 0.85
#   ln_len         assembly length                       lambda 0.60
#   ln_genes       gene count                            lambda 0.31
#   gc             GC content                            lambda 0.91
#   ln_intronlen   mean intron length                    lambda 0.00
#
# Dropped after audit: ln dN (r = 0.97 with ln dS, and omega now carries the contrast);
# number of single-exon genes (r = 0.80 with gene count).
#
# FIXED EFFECTS. BUSCO completeness only. Assembly quality is a nuisance that does not
# evolve on the tree, so it belongs here and not among the responses, which is the point
# NEE Reviewer 1 raised. Body mass is NOT a fixed effect because it sits inside the
# flight index, which is a response.
#
# RESIDUAL CORRELATION is retained, by decision, so that the phylogenetic and residual
# split is estimated rather than assumed. With seven responses this is 21 phylogenetic
# plus 21 residual correlations on 82 taxa, which is ambitious. The convergence guard
# below refuses to let a bad fit pass silently.
#
# THE GREAT AUK is excluded. Its "assembly" is 19 Mb of reads mapped to the razorbill, so
# its genome length and gene count are mapping artefacts rather than measurements.
#
# Requires: brms, ape, phytools
# In:  ../output/traits_per_taxon.csv, ../data/dnds_branches.Rdata,
#      ../data/dated.auk.tre, ../data/Feng_Table_1.csv
# Out: ../output/mrpmm_fit.Rdata, ../output/mrpmm_correlations.csv,
#      ../output/mrpmm_diagnostics.csv, ../figures/Fig3_mrpmm.pdf

library(brms)
library(ape)
suppressMessages(library(phytools))

CHAINS <- 4
ITER   <- 4000
WARMUP <- 2000
ADAPT  <- 0.95
SEED   <- 42
# Set QUICK to TRUE for a compile-and-run check rather than a production fit.
QUICK  <- as.logical(Sys.getenv("MRPMM_QUICK", "FALSE"))
if (QUICK) { CHAINS <- 2; ITER <- 600; WARMUP <- 300 }

dir.create("../output", showWarnings = FALSE)
dir.create("../figures", showWarnings = FALSE)

tr  <- read.csv("../output/traits_per_taxon.csv", stringsAsFactors = FALSE)
phy <- read.tree("../data/dated.auk.tre")
load("../data/dnds_branches.Rdata")


# ---- 1. Per-taxon molecular rates ----
#
# dnres, dsres and dndsres are loci by taxa matrices of TERMINAL-BRANCH rates: entry
# [g, i] is the rate on taxon i's terminal branch for gene g. The per-taxon value below is
# the median of that across roughly 11,000 genes, which is a robust genome-wide summary
# and avoids the long right tail that a mean would track.

rate_of <- function(m) {
  v <- apply(m[, tr$code, drop = FALSE], 2, median, na.rm = TRUE)
  log(v)
}
tr$ln_ds <- rate_of(dsres)
tr$ln_w  <- rate_of(dndsres)
cat("per-taxon rates from", nrow(dnres), "loci; median loci per taxon:",
    median(colSums(!is.na(dsres[, tr$code]))), "\n")


# ---- 2. Per-taxon genome architecture and assembly quality ----

f <- read.csv("../data/Feng_Table_1.csv", check.names = FALSE, stringsAsFactors = FALSE)

# Matching our tips to Feng needs two rules, both established by inspection:
#   (a) Feng carries four TRINOMIALS, including Aquila chrysaetos canadensis and Strix
#       occidentalis caurina. Matching on the full name silently loses those taxa, which
#       is why an earlier version dropped them. Compare the first two words only.
#   (b) Nannopterum harrisi in Feng is Phalacrocorax harrisi on our tree.
# Together these recover 83 of 84; only Pinguinus is absent, as expected.
binom <- function(x) {
  w <- strsplit(trimws(x), "[ _]+")
  vapply(w, function(v) paste(v[1:2], collapse = "_"), character(1))
}
f$bin <- binom(f[["Latin name"]])
f$bin[f$bin == "Nannopterum_harrisi"] <- "Phalacrocorax_harrisi"
idx <- match(binom(tr$tip), f$bin)
cat("matched to Feng:", sum(!is.na(idx)), "of", nrow(tr),
    "| unmatched:", paste(tr$species[is.na(idx)], collapse = ", "), "\n")
g <- f[idx, ]

num <- function(x) as.numeric(gsub(",", "", x))
tr$ln_len       <- log(num(g[["Total_Len (bp)"]]))
tr$ln_genes     <- log(num(g[["Number of total gene"]]))
tr$gc           <- num(g[["CG content(%)"]])
tr$ln_intronlen <- log(num(g[["Mean intron length (bp)"]]))
tr$busco        <- num(g[["Complete BUSCOs (C, %)"]])


# ---- 3. Model frame ----

vars <- c("ln_ds", "ln_w", "loading_index", "ln_len", "ln_genes", "gc", "ln_intronlen")
dd <- tr[, c("tip", "code", "species", "ability", "style", vars, "busco")]
dd <- dd[complete.cases(dd[, c(vars, "busco")]), ]
dropped <- setdiff(tr$tip, dd$tip)
cat("taxa in the model:", nrow(dd), "of 84\n")
if (length(dropped)) cat("dropped for missing data:", paste(dropped, collapse = ", "), "\n")

# ---- 3b. Pre-fit diagnostics ----
#
# Every response is checked for extreme skew and for phylogenetic signal BEFORE fitting.
# Both drove the failure of the first specification, so they are reported rather than
# assumed. Skew beyond about |1.5| or kurtosis beyond about 5 is flagged.

skew <- function(x) { x <- x[is.finite(x)]; mean((x - mean(x))^3) / sd(x)^3 }
kurt <- function(x) { x <- x[is.finite(x)]; mean((x - mean(x))^4) / sd(x)^4 - 3 }

phy_all <- read.tree("../data/dated.auk.tre")
diag_tab <- do.call(rbind, lapply(vars, function(v) {
  x <- dd[[v]]
  p2 <- drop.tip(phy_all, setdiff(phy_all$tip.label, dd$tip))
  if (!is.ultrametric(p2)) p2 <- phytools::force.ultrametric(p2, method = "extend")
  xx <- setNames(as.numeric(scale(x)), dd$tip)[p2$tip.label]
  lam <- tryCatch(phytools::phylosig(p2, xx, method = "lambda")$lambda,
                  error = function(e) NA_real_)
  data.frame(variable = v, n = sum(is.finite(x)), skew = skew(x), kurtosis = kurt(x),
             lambda = lam, row.names = NULL)
}))
diag_tab$flag <- ifelse(abs(diag_tab$skew) > 1.5 | diag_tab$kurtosis > 5, "SKEWED", "")
write.csv(diag_tab, "../output/mrpmm_diagnostics.csv", row.names = FALSE)
cat("\nResponse diagnostics:\n\n")
print(format(diag_tab, digits = 3), row.names = FALSE)

cm <- cor(dd[, vars])
off <- cm[upper.tri(cm)]
cat("\nmax pairwise |r| among responses:", round(max(abs(off)), 3), "\n")
hi <- which(abs(cm) > 0.7 & upper.tri(cm), arr.ind = TRUE)
if (nrow(hi)) {
  cat("WARNING, collinear response pairs above 0.7:\n")
  for (i in seq_len(nrow(hi)))
    cat("   ", vars[hi[i, 1]], "~", vars[hi[i, 2]], round(cm[hi[i, 1], hi[i, 2]], 3), "\n")
}
if (any(diag_tab$flag == "SKEWED")) {
  cat("\nNOTE: ", paste(diag_tab$variable[diag_tab$flag == "SKEWED"], collapse = ", "),
      " is skewed. For the flight index this is driven by the wing-propelled divers and\n",
      "the ratites, which are real biology rather than error, but a Gaussian response is\n",
      "an approximation there and the posterior should be checked against it.\n", sep = "")
}


# Standardise so that the covariance matrices are correlations and the priors are sane.
for (v in vars) dd[[v]] <- as.numeric(scale(dd[[v]]))
dd$busco <- as.numeric(scale(dd$busco))

phy <- drop.tip(phy, setdiff(phy$tip.label, dd$tip))
# The dated tree fails is.ultrametric by rounding only. Left as is, the phylogenetic
# covariance is poorly conditioned and sampling stalls, so the rounding is absorbed here.
if (!is.ultrametric(phy)) {
  phy <- phytools::force.ultrametric(phy, method = "extend")
  message("tree coerced to ultrametric (rounding only)")
}
A <- vcv.phylo(phy, corr = TRUE)
ev <- eigen(A, only.values = TRUE)$values
cat("phylogenetic covariance: condition", format(max(ev) / min(ev), digits = 3),
    " min eigenvalue", format(min(ev), digits = 3), "\n")
dd <- dd[match(rownames(A), dd$tip), ]
dd$phylo <- dd$tip
stopifnot(identical(dd$phylo, rownames(A)))


# ---- 4. Fit ----
#
# The shared |p| term makes the phylogenetic random effects correlated across responses,
# giving the phylogenetic covariance matrix. set_rescor(TRUE) gives the residual
# covariance. The split between the two is the whole point of the method.

bf_list <- lapply(vars, function(v) {
  bf(as.formula(paste0(v, " ~ busco + (1|p|gr(phylo, cov = A))")))
})
form <- Reduce(`+`, bf_list) + set_rescor(TRUE)

# In a multivariate model every population-level prior is response-specific, so they are
# built per response rather than declared once. lkj(2) on both correlation matrices mildly
# shrinks towards independence, which is the conservative choice here.
resp_nm <- gsub("[^A-Za-z0-9]", "", vars)
pr <- c(
  do.call(c, lapply(resp_nm, function(r) prior_string("normal(0, 1)", class = "b", resp = r))),
  # Responses are standardised, so a phylogenetic sd much above 1 is implausible. The
  # brms default student_t(3, 0, 2.5) is diffuse enough that the sampler wanders into the
  # region where phylogenetic and residual variance trade off against each other, which
  # is where the chains failed to mix (Rhat 1.99 on a short run).
  do.call(c, lapply(resp_nm, function(r) prior_string("student_t(3, 0, 1)", class = "sd", resp = r))),
  prior(lkj(2), class = "cor"),
  prior(lkj(2), class = "rescor"))

cat("\nfitting", length(vars), "responses on", nrow(dd), "taxa",
    if (QUICK) "(QUICK mode)" else "", "\n")
fit <- brm(form, data = dd, data2 = list(A = A), prior = pr,
           chains = CHAINS, iter = ITER, warmup = WARMUP, seed = SEED,
           control = list(adapt_delta = ADAPT, max_treedepth = 12),
           cores = min(CHAINS, parallel::detectCores()))

save(fit, dd, A, vars, file = "../output/mrpmm_fit.Rdata")


# ---- 5. Convergence ----

rh <- brms::rhat(fit); es <- brms::neff_ratio(fit)
max_rhat <- max(rh, na.rm = TRUE)
cat("\nmax Rhat:", round(max_rhat, 4),
    " min ESS ratio:", round(min(es, na.rm = TRUE), 3),
    " divergences:", sum(subset(nuts_params(fit), Parameter == "divergent__")$Value), "\n")
if (max_rhat > 1.05) {
  warning("CHAINS HAVE NOT MIXED (Rhat > 1.05). Do not interpret the correlations below. ",
          "Separating phylogenetic from residual covariance is weakly identified with ",
          "81 taxa. Options, in order: run without QUICK; drop to three responses; ",
          "fix the phylogenetic signal rather than estimating it per response.",
          call. = FALSE)
}


# ---- 6. Phylogenetic and residual correlations ----

dr <- as_draws_df(fit)
nm <- gsub("[^A-Za-z0-9]", "", vars)

grab <- function(pattern) {
  cl <- grep(pattern, names(dr), value = TRUE)
  if (!length(cl)) return(NULL)
  do.call(rbind, lapply(cl, function(c0) {
    v <- dr[[c0]]
    data.frame(term = c0, mean = mean(v),
               lwr = unname(quantile(v, .025)), upr = unname(quantile(v, .975)),
               p_dir = max(mean(v > 0), mean(v < 0)), row.names = NULL)
  }))
}
phy_cor <- grab("^cor_phylo__")
res_cor <- grab("^rescor__")
cors <- rbind(cbind(level = "phylogenetic", phy_cor), cbind(level = "residual", res_cor))
cors$credible <- cors$lwr > 0 | cors$upr < 0
write.csv(cors, "../output/mrpmm_correlations.csv", row.names = FALSE)

cat("\nCredible correlations (95% interval excluding zero):\n\n")
cr <- cors[cors$credible, c("level", "term", "mean", "lwr", "upr")]
if (nrow(cr)) print(format(cr, digits = 2), row.names = FALSE) else cat("  none\n")


# ---- 7. Omega, recovered from the posterior ----
#
# ln(omega) = ln(dN) - ln(dS), so the omega effect of any predictor is the difference of
# its dN and dS effects, taken draw by draw so that the uncertainty is correct.

b_dn <- dr[["b_lndn_busco"]]; b_ds <- dr[["b_lnds_busco"]]
if (!is.null(b_dn) && !is.null(b_ds)) {
  w <- b_dn - b_ds
  cat(sprintf("\nBUSCO effect on ln(omega), derived: %.3f [%.3f, %.3f], P(dir) = %.2f\n",
              mean(w), quantile(w, .025), quantile(w, .975),
              max(mean(w > 0), mean(w < 0))))
}


# ---- 8. Figure ----

cor_matrix <- function(prefix) {
  M <- diag(length(vars)); dimnames(M) <- list(nm, nm)
  for (i in seq_along(nm)) for (j in seq_along(nm)) {
    if (i >= j) next
    cl <- grep(paste0("^", prefix, ".*", nm[i], ".*", nm[j]), names(dr), value = TRUE)
    if (length(cl) == 1) M[i, j] <- M[j, i] <- mean(dr[[cl]])
  }
  M
}
Mp <- cor_matrix("cor_phylo__"); Mr <- cor_matrix("rescor__")

pdf("../figures/Fig3_mrpmm.pdf", width = 11, height = 5.4)
par(mfrow = c(1, 2), mar = c(7.5, 7.5, 3, 2))
ramp <- colorRampPalette(c("#2B6B8F", "white", "#C4622D"))(101)
show_mat <- function(M, main) {
  image(seq_along(nm), seq_along(nm), t(M[rev(seq_along(nm)), ]), zlim = c(-1, 1),
        col = ramp, axes = FALSE, xlab = "", ylab = "", main = main, font.main = 1)
  axis(1, at = seq_along(nm), labels = nm, las = 2, cex.axis = 0.8, tick = FALSE)
  axis(2, at = seq_along(nm), labels = rev(nm), las = 2, cex.axis = 0.8, tick = FALSE)
  for (i in seq_along(nm)) for (j in seq_along(nm))
    text(j, length(nm) - i + 1, sprintf("%.2f", M[i, j]), cex = 0.7,
         col = ifelse(abs(M[i, j]) > 0.6, "white", "grey20"))
  box(col = "grey50")
}
show_mat(Mp, "Phylogenetic correlation")
show_mat(Mr, "Residual correlation")
dev.off()
cat("\nwritten ../figures/Fig3_mrpmm.pdf\n")
