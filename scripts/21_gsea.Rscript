# 21_gsea.Rscript
#
# Gene-set enrichment on the continuous per-gene statistic, for each of the three
# phenotypes.
#
# WHY GSEA RATHER THAN OVER-REPRESENTATION. The previous submission ran an
# over-representation analysis on the top 10 percent of genes and reported enrichment at
# FDR q < 0.5. Two referees attacked exactly that: nothing passed at the 1 or 5 percent
# cut, the result appeared only at 10 percent under a permissive threshold, and the term
# "metabolic pathways" was significant in all four scenarios. GSEA removes the arbitrary
# threshold entirely by ranking every gene and asking whether a set is concentrated at
# either end. There is no cut to tune, and the background is the full ranked list rather
# than a set chosen by hand.
#
# RANKING STATISTIC. The relative-evolutionary-rate correlation from script 20's
# comparator, NOT a HyphAeon statistic.
#
# This is a correction. GSEA requires a ranking that is centred near zero under the null,
# or it reports the global shift of the list instead of set-specific enrichment. None of
# HyphAeon's gene summaries meets that. Measured on the full screen: rho at the
# highest-scoring site is positive for 99.2 percent of genes, and the mean and median
# across sites are positive for only 24 and 18 percent. An earlier run ranked on the first
# of these returned 28 sets at q < 0.05 with EVERY NES positive, which is the signature of
# an uncentred list rather than a finding.
#
# The comparator is centred by construction, because it is built by double-centring the
# log per-locus per-taxon rates. Measured: positive fraction 0.488, 0.466 and 0.533 across
# the three phenotypes, with p-values of median 0.446 to 0.498 and uniform by
# Kolmogorov-Smirnov for two of the three. It is also the statistic that actually found
# something, 9 genes at q < 0.05 for the flight index where HyphAeon found none.
#
# The HyphAeon summaries are still run, as a sensitivity, and the centring of whatever is
# used is checked before GSEA sees it.
#
# Reported at q < 0.05. A null result is reported as a null result.
#
# GENE SETS. GSEA_SETS=GO (default) or GSEA_SETS=KEGG. KEGG pathways, as in the previous
# submission, come from ../data/kegg_sets.csv built by 21a_kegg_sets. Outputs for KEGG
# carry the suffix _kegg.
#
# Requires: clusterProfiler (Bioconductor). fgsea alone would also serve.
# In:  ../output/contrast_screen.csv, and where present ../output/per_gene_statistics.csv
#      and ../output/rer_comparator.csv; ../data/goterms.csv or ../data/kegg_sets.csv
# Out: ../output/gsea_results{,_kegg}.csv, ../figures/FigX_gsea{,_kegg}.pdf

suppressMessages(library(clusterProfiler))

MIN_SET <- 10      # sets smaller than this are unstable
MAX_SET <- 500     # sets larger than this are too vague to interpret
QCUT    <- 0.05
SETS    <- toupper(Sys.getenv("GSEA_SETS", "GO"))
SUF     <- if (SETS == "KEGG") "_kegg" else ""

dir.create("../output", showWarnings = FALSE)
dir.create("../figures", showWarnings = FALSE)


# ---- 1. Gene sets from the project's own annotation ----
#
# goterms.csv carries a free-text GO field per locus. Parsing it directly avoids an
# OrgDb dependency and keeps the annotation identical to the previous version, so any
# difference in result comes from the method and not from a change of gene sets.

go <- read.csv("../data/goterms.csv", stringsAsFactors = FALSE, row.names = 1)
go <- go[!is.na(go$fullgo) & !grepl("^\\s*NA\\s*$", go$fullgo), ]
rx <- "GO:[0-9]{7}; [^;]+; (function|process|component)"
hits <- regmatches(go$fullgo, gregexpr(rx, go$fullgo))

t2g <- do.call(rbind, lapply(seq_along(hits), function(i) {
  if (!length(hits[[i]])) return(NULL)
  data.frame(term = sub(";.*$", "", hits[[i]]), gene = go$ID[i], stringsAsFactors = FALSE)
}))
t2n <- unique(data.frame(
  term = sub(";.*$", "", unlist(hits)),
  name = sub("^GO:[0-9]{7}; ", "", sub("; (function|process|component)$", "", unlist(hits))),
  stringsAsFactors = FALSE))
t2n <- t2n[!duplicated(t2n$term), ]

if (SETS == "KEGG") {
  ks  <- read.csv("../data/kegg_sets.csv", stringsAsFactors = FALSE)
  t2g <- unique(ks[, c("term", "gene")])
  t2n <- unique(ks[, c("term", "name")])
}

cat("gene sets:", length(unique(t2g$term)), SETS, "sets over",
    length(unique(t2g$gene)), "loci,", nrow(t2g), "term-gene pairs\n")
sz <- table(t2g$term)
cat("sets within size bounds (", MIN_SET, "to", MAX_SET, "):",
    sum(sz >= MIN_SET & sz <= MAX_SET), "\n\n")


# ---- 2. Ranked lists ----

# The HyphAeon and comparator rankings are sensitivities; run without them if absent.
read_opt <- function(f) if (file.exists(f)) read.csv(f, stringsAsFactors = FALSE) else NULL
res <- read_opt("../output/per_gene_statistics.csv")
if (!is.null(res)) res$key <- sub("[.]c123.*$", "", res$gene)
cmp <- read_opt("../output/rer_comparator.csv")
csc <- read.csv("../output/contrast_screen.csv", stringsAsFactors = FALSE)
csc$key <- sub("[.]c123.*$", "", csc$gene)

# PRIMARY is the sister-pair contrast screen on the continuous flight index, restricted
# to the two rate-by-phenotype screens that clear their resolution floor (dS and omega
# against the loading index). The comparator runs alongside it, and the HyphAeon
# summaries run only as a sensitivity.
contrast_src <- function(rate) {
  d <- csc[csc$rate == rate & csc$phenotype == "loading", c("key", "r")]
  names(d)[2] <- "stat"; d$phenotype <- "loading"; d
}
STATS <- list(
  contrast_dS    = list(src = "csc_dS",    col = "stat"),
  contrast_omega = list(src = "csc_omega", col = "stat"),
  comparator     = list(src = "cmp",       col = "rer_rho"),
  hyphaeon_mean  = list(src = "res",       col = "mean_rho"),
  hyphaeon_top   = list(src = "res",       col = "top_rho"))

rank_of <- function(ph, which_stat) {
  cfg <- STATS[[which_stat]]
  d <- switch(cfg$src,
    cmp      = cmp[cmp$phenotype == ph, ],
    res      = res[res$phenotype == ph, ],
    csc_dS   = if (ph == "loading") contrast_src("dS")    else NULL,
    csc_omega= if (ph == "loading") contrast_src("omega") else NULL)
  if (is.null(d)) return(NULL)
  d <- d[is.finite(d[[cfg$col]]), ]
  if (!nrow(d)) return(NULL)
  d <- d[!duplicated(d$key), ]
  sort(setNames(d[[cfg$col]], d$key), decreasing = TRUE)
}


# ---- 3. GSEA ----

run_one <- function(ph, which_stat) {
  gl <- rank_of(ph, which_stat)
  if (is.null(gl) || length(gl) < 100) {
    cat("skipping", ph, "/", which_stat, ": too few genes\n")
    return(NULL)
  }
  fpos <- mean(gl > 0)
  annotated <- sum(names(gl) %in% t2g$gene)
  cat(sprintf("%-11s %-14s %5d genes, %5d annotated, frac>0 %.3f%s\n",
              ph, which_stat, length(gl), annotated, fpos,
              if (abs(fpos - 0.5) > 0.25) "   <-- UNCENTRED, results not interpretable" else ""))
  e <- tryCatch(
    GSEA(gl, TERM2GENE = t2g, TERM2NAME = t2n, minGSSize = MIN_SET,
         maxGSSize = MAX_SET, pvalueCutoff = 1, eps = 0, seed = TRUE, verbose = FALSE),
    error = function(err) { cat("  GSEA failed:", conditionMessage(err), "\n"); NULL })
  if (is.null(e) || !nrow(as.data.frame(e))) return(NULL)
  df <- as.data.frame(e)
  df$phenotype <- ph
  df$statistic <- which_stat
  df$frac_positive <- fpos
  df
}

grid <- expand.grid(ph = unique(c(res$phenotype, cmp$phenotype, csc$phenotype)),
                    st = names(STATS), stringsAsFactors = FALSE)
all_res <- do.call(rbind, Filter(Negate(is.null),
  mapply(run_one, grid$ph, grid$st, SIMPLIFY = FALSE)))
if (is.null(all_res)) {
  cat("\nNo GSEA results produced. Run 19_hyphaeon_run.py over the full gene set first.\n")
  quit(save = "no")
}
write.csv(all_res, paste0("../output/gsea_results", SUF, ".csv"), row.names = FALSE)

cat("\n", strrep("=", 78), "\n", sep = "")
# Only the centred statistic is reportable. The rest are kept in the CSV for the record.
# The gate was first set at 0.1, calibrated against HyphAeon's artefact where 99.4% of
# genes scored positive. A genuine genome-wide shift is different in kind: the dS contrast
# statistic sits at 0.674 because there really is a weak genome-wide dS trend, matching
# script 16. GSEA permutes gene labels, so it tolerates a modest shift but not a list that
# is almost entirely one-signed. 0.25 separates the two cases.
all_res$interpretable <- abs(all_res$frac_positive - 0.5) < 0.25
sig <- all_res[all_res$p.adjust < QCUT & all_res$interpretable, ]
if (nrow(sig)) {
  cat("Enriched sets at q <", QCUT, ":\n\n")
  print(format(sig[order(sig$p.adjust),
                   c("phenotype", "statistic", "Description", "setSize", "NES",
                     "p.adjust")], digits = 3), row.names = FALSE)
  cat("\nNES sign split (a healthy run has both):\n")
  print(table(sig$phenotype, ifelse(sig$NES > 0, "positive", "negative")))
} else {
  cat("No gene set is enriched at q < ", QCUT, " for any phenotype.\n\n", sep = "")
  cat("This is the result, not a failure of the analysis. The previous submission\n")
  cat("reported enrichment only by cutting at the top 10 percent of genes and\n")
  cat("relaxing the threshold to q < 0.5, which two referees rejected. GSEA uses no\n")
  cat("cut, so a null here is a null.\n\n")
  cat("Closest sets by adjusted p-value, for reference only:\n\n")
  print(format(head(all_res[order(all_res$p.adjust),
                            c("phenotype", "ID", "Description", "setSize", "NES",
                              "pvalue", "p.adjust")], 10), digits = 3), row.names = FALSE)
}
cat(strrep("=", 78), "\n")


# ---- 4. Figure ----

pdf(paste0("../figures/FigX_gsea", SUF, ".pdf"), width = 10, height = 6)
all_res <- all_res[all_res$interpretable, ]
if (!nrow(all_res)) { dev.off(); cat("\nno interpretable ranking available\n"); quit(save="no") }
phs <- unique(all_res$phenotype)
par(mfrow = c(1, max(1, length(phs))), mar = c(4.2, 12, 2.8, 1), tcl = -0.25,
    mgp = c(2.5, 0.5, 0), cex.axis = 0.8)
for (ph in phs) {
  d <- all_res[all_res$phenotype == ph, ]
  d <- head(d[order(d$p.adjust), ], 12)
  if (!nrow(d)) { plot.new(); next }
  d <- d[order(d$NES), ]
  cols <- ifelse(d$p.adjust < QCUT, "#C4622D", "#9AA5AB")
  b <- barplot(d$NES, horiz = TRUE, col = cols, border = NA, xlab = "",
               main = ph, font.main = 1, cex.main = 1, las = 1,
               names.arg = rep("", nrow(d)))
  axis(2, at = b, labels = substr(d$Description, 1, 40), las = 1, tick = FALSE,
       cex.axis = 0.62)
  abline(v = 0, col = "grey50")
  mtext("normalised enrichment score", side = 1, line = 2.3, cex = 0.72)
  box(bty = "l", col = "grey45")
}
dev.off()
cat("\nwritten ../figures/FigX_gsea", SUF, ".pdf\n", sep = "")
cat("orange bars pass q <", QCUT, "; grey bars do not\n")
